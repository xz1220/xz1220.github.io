---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "A bit about me and the things I build.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I'm Daniel Xing — a Builder. I like turning ideas into working things: I design them, write
			the code, ship them, and then write about what I learned along the way.
		</p>
		<p>
			My background is in backend and algorithms, and I'm currently exploring ideas at the
			intersection of AI and product. This site is where I collect the things I build and the
			notes I write.
		</p>
		<p>Two things you'll find here:</p>
		<ul class="list-inside list-disc" role="list">
			<li>
				<a class="cactus-link" href="/projects/">Projects</a> — things I've built, newest first.
			</li>
			<li>
				<a class="cactus-link" href="/posts/">Blog</a> — posts on what I'm working on and learning.
			</li>
		</ul>
	</div>
	<div class="mt-8">
		<SocialList />
	</div>
</PageLayout>
