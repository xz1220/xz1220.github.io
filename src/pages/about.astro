---
import TitlePage from "@/components/book/TitlePage.astro";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
import { latinSpansHtml } from "@/utils/typeset";

const meta = {
	description: "关于 Daniel Xing（邢政）：做 AI Agent 的工程师，现在主要在做 Open Dynamic Workflows。",
	title: "关于",
};
---

<PageLayout bodyClass="about" meta={meta}>
	<main class="spread" id="main">
		<TitlePage byline={latinSpansHtml(siteConfig.author)} title="关于" />
		<div class="pages">
			<section aria-labelledby="bio-title" class="about-block">
				<h2 class="part-title" id="bio-title">作者简介</h2>
				<p class="bio">
					我是邢政（<span class="latin" lang="en">Daniel Xing</span><span class="pc">）</span>，做 AI Agent
					的工程师。2024 年底到 2026 年中，我在一家大厂做 AI 创作平台的 Agent 架构，之后离职创业。现在主要在做 <a
						href="/projects/open-dynamic-workflows/">Open Dynamic Workflows</a
					>，一个让动态工作流跨 Coding Agent 运行的开源运行时。
				</p>
			</section>

			<section aria-labelledby="contact-title" class="about-block">
				<h2 class="part-title" id="contact-title">联系</h2>
				<dl class="facts">
					<dt lang="en">GitHub</dt>
					<dd><a href="https://github.com/xz1220" lang="en">github.com/xz1220</a></dd>
					<dt lang="en">X</dt>
					<dd><a href="https://x.com/DanielsCabin" lang="en">@DanielsCabin</a></dd>
					<dt>知乎</dt>
					<dd><a href="https://www.zhihu.com/people/xz1220">知乎主页</a></dd>
					<dt>小红书</dt>
					<dd><a href="https://www.xiaohongshu.com/user/profile/655488ff00000000080023a0">小红书主页</a></dd>
					<dt lang="en">Email</dt>
					<dd><a href="mailto:danielxing1@163.com" lang="en">danielxing1@163.com</a></dd>
					<dt lang="en">RSS</dt>
					<dd><a href="/rss.xml" lang="en">xz1220.github.io/rss.xml</a></dd>
					<dt>微信</dt>
					<dd lang="en">Xingzheng-daniel</dd>
				</dl>
			</section>

			<section aria-labelledby="site-title" class="about-block">
				<h2 class="part-title" id="site-title">关于本站</h2>
				<dl class="facts small">
					<dt>排印</dt>
					<dd>Noto Serif SC 与 Source Serif 4。长文的引用与出处放在页边注里，窄屏时出现在段落之后。</dd>
					<dt>夜读</dt>
					<dd>默认跟随系统，也可以用页眉的「日 / 夜」切换。</dd>
					<dt>文章</dt>
					<dd>多数首发于知乎，迁移到这里时保留原文链接。</dd>
					<dt>构建</dt>
					<dd>Astro，托管于 GitHub Pages。</dd>
					<dt>源码</dt>
					<dd>
						<a href="https://github.com/xz1220/xz1220.github.io" lang="en"
							>github.com/xz1220/xz1220.github.io</a
						>
					</dd>
				</dl>
			</section>
		</div>
	</main>
</PageLayout>
