---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "The page you wanted isn't here.",
	title: "404",
};
---

<PageLayout meta={meta}>
	<p class="text-accent font-mono text-sm">404</p>
	<h1 class="title mt-2 mb-6 text-3xl sm:text-4xl">Page not found</h1>
	<p class="text-muted max-w-prose">
		The page you wanted isn't here. It may have moved, or never existed.
	</p>
	<p class="mt-8">
		<a class="mono-label hover:text-accent no-underline underline-offset-4 hover:underline" href="/"
			>← back to home</a
		>
	</p>
</PageLayout>
