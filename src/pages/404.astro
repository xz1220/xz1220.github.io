---
import TitlePage from "@/components/book/TitlePage.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "这个页面不存在。",
	title: "页面不存在",
};
---

<PageLayout bodyClass="home" meta={meta}>
	<main class="spread" id="main">
		<TitlePage byline='<span class="latin">404</span>' title="缺页" />
		<div class="pages">
			<section aria-labelledby="missing-title" class="about-block">
				<h2 class="part-title" id="missing-title">这一页不存在</h2>
				<p class="bio">它可能已经移动或删除，也可能从来没有写过。</p>
				<p class="more"><a href="/">回到目录 →</a></p>
			</section>
		</div>
	</main>
</PageLayout>
