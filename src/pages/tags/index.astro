---
import TitlePage from "@/components/book/TitlePage.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const tags = getUniqueTagsWithCount(await getAllPosts());
const meta = {
	description: "按标签浏览文章。",
	title: "标签",
};
---

<PageLayout bodyClass="home" meta={meta}>
	<main class="spread" id="main">
		<TitlePage byline={siteConfig.byline} title="标签" />
		<div class="pages">
			<section aria-labelledby="tags-title">
				<h2 class="section-title" id="tags-title">标签 <span class="en" lang="en">Tags</span></h2>
				<ul class="mini-list">
					{
						tags.map(([tag, count]) => (
							<li>
								<a href={`/tags/${tag}/`}>
									<span class="mn" lang="en">
										#{tag}
									</span>
									<span class="md" />
									<span class="ms">{count} 篇</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</main>
</PageLayout>
