---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	return paginate(allPostsByDate, {
		pageSize: 15,
		props: {
			tagsWithCount: getUniqueTagsWithCount(allPosts),
			totalPosts: allPosts.length,
		},
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	tagsWithCount: [string, number][];
	totalPosts: number;
}

const { page, tagsWithCount, totalPosts } = Astro.props;
const meta = {
	description: "Notes on building AI agents, multi-agent systems, AI products, and knowledge work.",
	title: "Posts",
};

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Newer", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Older →", url: page.url.next } }),
};
---

<PageLayout meta={meta}>
	<header class="section-head mb-10">
		<h1 class="title">Posts</h1>
		<p class="meta-text">
			{totalPosts}
			{totalPosts === 1 ? "post" : "posts"}
			<span aria-hidden="true"> · </span>
			<a class="section-link" href="/rss.xml">RSS</a>
		</p>
	</header>

	{
		tagsWithCount.length >= 2 && (
			<nav aria-label="Filter by tag" class="entry-meta mb-8">
				{tagsWithCount.map(([tag, count]) => (
					<a href={`/tags/${tag}/`}>
						#{tag} <span class="text-muted">{count}</span>
					</a>
				))}
			</nav>
		)
	}

	{
		page.data.length > 0 ? (
			<ul class="entry-list" role="list">
				{page.data.map((post) => (
					<li>
						<PostPreview post={post} />
					</li>
				))}
			</ul>
		) : (
			<p class="text-muted">No posts yet.</p>
		)
	}
	<Pagination {...paginationProps} />
</PageLayout>
