---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getAllProjects } from "@/data/project";
import { getListedWorks, workForRepo } from "@/data/works";
import PageLayout from "@/layouts/Base.astro";
import { escapeHtml, latinSpansHtml } from "@/utils/typeset";

export const getStaticPaths = (async () => {
	const works = await getListedWorks();
	// Only works that clear the star threshold get a page (see src/data/works.ts).
	return (await getAllProjects()).flatMap((project) => {
		const work = workForRepo(works, project.data.repo);
		return work ? [{ params: { slug: project.id }, props: { project, work } }] : [];
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, work } = Astro.props;
const { title, description, repo, demo } = project.data;
const { Content } = await render(project);

const metaHtml = [
	work?.language && escapeHtml(work.language),
	work && `★ ${work.stars}`,
	work?.status?.label,
	repo && `<a href="${escapeHtml(repo)}" rel="noopener noreferrer" target="_blank">GitHub ↗</a>`,
	demo && `<a href="${escapeHtml(demo)}" rel="noopener noreferrer" target="_blank">Demo ↗</a>`,
]
	.filter(Boolean)
	.map((item) => `<span class="mi">${item}</span>`)
	.join('<span class="sep">·</span>');
---

<PageLayout bodyClass="article" meta={{ title, description }}>
	<main class="chapter" id="main">
		<header class="chapter-head">
			<div>
				<p class="kicker">作品 · <Fragment set:html={latinSpansHtml(work?.group ?? "")} /></p>
				<h1 class="chapter-title" lang="en">{title}</h1>
				<p class="chapter-deck" lang="en">{description}</p>
				<p class="meta" set:html={metaHtml} />
			</div>
		</header>
		<article class="prose" lang="en">
			<Content />
		</article>
	</main>
	<nav aria-label="文末" class="chapter-end">
		<p class="back"><a href="/projects/">回到作品</a></p>
	</nav>
</PageLayout>
