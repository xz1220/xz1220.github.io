---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getAllProjects } from "@/data/project";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allProjects = await getAllProjects();
const projectsByDate = allProjects.sort(collectionDateSort) as CollectionEntry<"project">[];

const meta = {
	description: "Things I've designed, built, and shipped — newest first.",
	title: "Projects",
};
---

<PageLayout meta={meta}>
	<div class="mb-10 flex flex-wrap items-baseline justify-between gap-2">
		<h1 class="title text-3xl sm:text-4xl">Projects</h1>
		<p class="mono-label">
			{projectsByDate.length} shipped
		</p>
	</div>
	{
		projectsByDate.length > 0 ? (
			<div class="flex flex-col gap-16">
				{projectsByDate.map((project, i) => (
					<ProjectCard project={project} fig={i + 1} />
				))}
			</div>
		) : (
			<p class="text-muted">No projects yet.</p>
		)
	}
</PageLayout>
