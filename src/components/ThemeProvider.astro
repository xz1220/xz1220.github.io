{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function getStoredTheme() {
		return typeof localStorage !== "undefined" ? localStorage.getItem("theme") : null;
	}

	function getUserPref() {
		return getStoredTheme() || (lightModePref.matches ? "light" : "dark");
	}

	function applyTheme(newTheme) {
		const root = document.documentElement;
		if (newTheme !== root.getAttribute("data-theme")) {
			root.setAttribute("data-theme", newTheme);
		}
	}

	// initial setup — applied, not persisted: only an explicit toggle writes localStorage
	applyTheme(getUserPref());

	// listen for theme-change custom event, fired in src/components/ThemeToggle.astro
	document.addEventListener("theme-change", (e) => {
		if (e.detail.theme !== "light" && e.detail.theme !== "dark") {
			return;
		}
		applyTheme(e.detail.theme);
		if (typeof localStorage !== "undefined") {
			localStorage.setItem("theme", e.detail.theme);
		}
	});

	// follow the OS preference only while the user has not made an explicit choice
	lightModePref.addEventListener("change", (e) => {
		if (!getStoredTheme()) {
			applyTheme(e.matches ? "light" : "dark");
		}
	});
</script>
