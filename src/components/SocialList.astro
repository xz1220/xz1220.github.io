---
const socialLinks: {
	friendlyName: string;
	link: string;
	external?: boolean;
}[] = [
	{
		friendlyName: "github",
		link: "https://github.com/xz1220",
		external: true,
	},
	{
		friendlyName: "x",
		link: "https://x.com/xngzhng118250",
		external: true,
	},
	{
		friendlyName: "email",
		link: "mailto:3024979463@qq.com",
	},
	{
		friendlyName: "rss",
		link: "/rss.xml",
		external: true,
	},
];
---

<ul class="flex flex-wrap items-center gap-x-5 gap-y-2" role="list">
	{
		socialLinks.map(({ friendlyName, link, external }) => (
			<li class="flex">
				<a
					class="text-muted hover:text-accent font-mono text-sm no-underline underline-offset-4 hover:underline"
					href={link}
					rel={external ? "noreferrer" : undefined}
					target={external ? "_blank" : undefined}
					aria-label={friendlyName === "x" ? "Daniel Xing on X" : undefined}
				>
					{friendlyName}
					{external && (
						<span aria-hidden="true" class="ml-0.5 text-xs">
							↗
						</span>
					)}
				</a>
			</li>
		))
	}
</ul>
