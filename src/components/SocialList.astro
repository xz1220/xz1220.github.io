---
const socialLinks: {
	friendlyName: string;
	link: string;
	external?: boolean;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/xz1220",
		external: true,
	},
	{
		friendlyName: "X",
		link: "https://x.com/DanielsCabin",
		external: true,
	},
	{
		friendlyName: "Email",
		link: "mailto:danielxing1@163.com",
	},
	{
		friendlyName: "Zhihu",
		link: "https://www.zhihu.com/people/xz1220",
		external: true,
	},
	{
		friendlyName: "Xiaohongshu",
		link: "https://www.xiaohongshu.com/user/profile/655488ff00000000080023a0",
		external: true,
	},
	{
		friendlyName: "RSS",
		link: "/rss.xml",
	},
];
---

<ul class="social-list" role="list">
	{
		socialLinks.map(({ friendlyName, link, external }) => (
			<li>
				<a
					href={link}
					rel={external ? "noreferrer" : undefined}
					target={external ? "_blank" : undefined}
					aria-label={friendlyName === "X" ? "Daniel Xing on X" : undefined}
				>
					{friendlyName}
				</a>
			</li>
		))
	}
</ul>
