---
/* The narrow, pinned 扉页 on the left of a spread. Title and byline are trusted HTML. */
interface Props {
	title: string;
	byline?: string;
	id?: string;
}

const { title, byline, id = "page-title" } = Astro.props;
---

<section aria-labelledby={id} class="titlepage">
	<h1 class="book-title" id={id} set:html={title} />
	<hr class="title-rule" />
	{byline && <p class="byline" set:html={byline} />}
</section>
<div aria-hidden="true" class="gutter"></div>
