---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";

const { pathname } = Astro.url;
const isCurrent = (path: string) => (path === "/" ? pathname === "/" : pathname.startsWith(path));
const sectionLinks = menuLinks.filter((link) => link.path !== "/");
---

<header
	class="group border-line relative mb-14 flex items-center justify-between gap-4 border-b pb-4"
	id="main-header"
>
	<a
		aria-current={isCurrent("/") ? "page" : false}
		class="text-accent-2 inline-flex items-baseline gap-2 font-mono text-base font-semibold tracking-tight no-underline"
		href="/"
	>
		<span class="text-accent" aria-hidden="true">~/</span>daniel-xing
	</a>

	<div class="flex items-center">
		<nav
			aria-label="Main menu"
			class="bg-global-bg border-line absolute -inset-x-4 top-12 hidden flex-col border-b px-2 py-4 shadow-sm group-[.menu-open]:z-50 group-[.menu-open]:flex sm:static sm:z-auto sm:flex sm:flex-row sm:items-center sm:gap-5 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
			id="navigation-menu"
		>
			{
				sectionLinks.map((link) => (
					<a
						aria-current={isCurrent(link.path) ? "page" : false}
						class:list={[
							"hover:text-global-text py-3 font-mono text-sm no-underline underline-offset-8 sm:py-0",
							isCurrent(link.path)
								? "text-global-text decoration-accent underline decoration-2"
								: "text-muted",
						]}
						href={link.path}
					>
						{link.title.toLowerCase()}
					</a>
				))
			}
		</nav>
		<Search />
		<ThemeToggle />
		<mobile-button>
			<button
				aria-controls="navigation-menu"
				aria-expanded="false"
				class="group relative ms-2 h-7 w-7 sm:invisible sm:hidden"
				id="toggle-navigation-menu"
				type="button"
			>
				<span class="sr-only" id="menu-btn-label">Open main menu</span>
				<svg
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-[scale,opacity] group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
					fill="none"
					focusable="false"
					id="line-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
					></path>
				</svg>
				<svg
					aria-hidden="true"
					class="text-accent absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-[scale,opacity] group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
					fill="none"
					focusable="false"
					id="cross-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</mobile-button>
	</div>
</header>

<script>
	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
			const labelEl = this.querySelector<HTMLSpanElement>("#menu-btn-label");

			const setOpen = (open: boolean) => {
				this.#menuOpen = open;
				headerEl?.classList.toggle("menu-open", open);
				mobileButtonEl?.setAttribute("aria-expanded", open.toString());
				if (labelEl) labelEl.textContent = open ? "Close main menu" : "Open main menu";
			};

			mobileButtonEl?.addEventListener("click", () => setOpen(!this.#menuOpen));

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && this.#menuOpen) setOpen(false);
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
