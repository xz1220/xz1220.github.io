---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

const { pathname } = Astro.url;
const isCurrent = (path: string) => (path === "/" ? pathname === "/" : pathname.startsWith(path));
const sectionLinks = menuLinks.filter((link) => link.path !== "/");
---

<header
	class="group relative z-[var(--z-sticky)] mb-12 flex min-h-11 items-center justify-between gap-3 sm:mb-14"
	id="main-header"
>
	<a
		aria-current={isCurrent("/") ? "page" : false}
		class="text-global-text inline-flex min-h-11 items-center text-lg font-semibold tracking-[-0.015em] whitespace-nowrap no-underline"
		href="/"
	>
		{siteConfig.title}
	</a>

	<div class="flex items-center">
		<nav
			aria-label="Main menu"
			class="bg-global-bg border-line absolute inset-x-0 top-full hidden flex-col border-y py-2 group-[.menu-open]:z-[var(--z-dropdown)] group-[.menu-open]:flex sm:static sm:z-auto sm:flex sm:flex-row sm:items-center sm:gap-1 sm:border-0 sm:bg-transparent sm:p-0"
			id="navigation-menu"
		>
			{
				sectionLinks.map((link) => (
					<a
						aria-current={isCurrent(link.path) ? "page" : false}
						class:list={[
							"inline-flex min-h-11 items-center px-3 text-sm whitespace-nowrap no-underline underline-offset-4",
							isCurrent(link.path)
								? "text-global-text decoration-accent underline decoration-1"
								: "text-muted hover:text-global-text",
						]}
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
		</nav>
		<Search />
		<ThemeToggle />
		<mobile-button>
			<button
				aria-controls="navigation-menu"
				aria-expanded="false"
				class="group text-muted hover:text-global-text relative ms-1 flex h-11 w-11 cursor-pointer items-center justify-center sm:invisible sm:hidden"
				id="toggle-navigation-menu"
				type="button"
			>
				<span class="sr-only" id="menu-btn-label">Open main menu</span>
				<svg
					aria-hidden="true"
					class="h-5 w-5 group-aria-expanded:hidden"
					fill="none"
					focusable="false"
					id="line-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
					></path>
				</svg>
				<svg
					aria-hidden="true"
					class="hidden h-5 w-5 group-aria-expanded:block"
					fill="none"
					focusable="false"
					id="cross-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</mobile-button>
	</div>
</header>

<script>
	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
			const labelEl = this.querySelector<HTMLSpanElement>("#menu-btn-label");
			const navigationEl = document.getElementById("navigation-menu");

			const setOpen = (open: boolean) => {
				this.#menuOpen = open;
				headerEl?.classList.toggle("menu-open", open);
				mobileButtonEl?.setAttribute("aria-expanded", open.toString());
				if (labelEl) labelEl.textContent = open ? "Close main menu" : "Open main menu";
				if (open) {
					requestAnimationFrame(() => navigationEl?.querySelector<HTMLAnchorElement>("a")?.focus());
				} else if (navigationEl?.contains(document.activeElement)) {
					mobileButtonEl?.focus();
				}
			};

			mobileButtonEl?.addEventListener("click", () => setOpen(!this.#menuOpen));

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && this.#menuOpen) setOpen(false);
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
