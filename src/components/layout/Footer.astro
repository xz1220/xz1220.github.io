---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="border-line mt-16 w-full border-t py-4">
	<div class="text-muted flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-sm">
		<p class="whitespace-nowrap">&copy; {year} {siteConfig.author}</p>
		<nav aria-labelledby="footer_links" class="flex flex-wrap items-center gap-x-1">
			<p id="footer_links" class="sr-only">More on this site</p>
			{
				menuLinks.map((link) => (
					<a
						class="hover:text-global-text inline-flex min-h-11 items-center px-2 whitespace-nowrap"
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
			<a
				class="hover:text-global-text inline-flex min-h-11 items-center px-2 whitespace-nowrap"
				href="/rss.xml">RSS</a
			>
		</nav>
	</div>
</footer>
