---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="border-line mt-auto w-full border-t pt-6 pb-6">
	<div
		class="text-muted flex flex-col items-start justify-between gap-3 font-mono text-xs sm:flex-row sm:items-center"
	>
		<p>&copy; {year} {siteConfig.author}</p>
		<nav aria-labelledby="footer_links" class="flex flex-wrap items-center gap-x-4 gap-y-1">
			<p id="footer_links" class="sr-only">More on this site</p>
			{
				menuLinks.map((link) => (
					<a class="hover:text-global-text" href={link.path}>
						{link.title.toLowerCase()}
					</a>
				))
			}
			<a class="hover:text-global-text" href="/rss.xml" target="_blank">rss</a>
		</nav>
		<p class="text-muted">source serif 4 · sometype mono · astro</p>
	</div>
</footer>
