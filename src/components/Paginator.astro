---
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav
			aria-label="Pagination"
			class="border-line mt-10 flex items-center gap-x-4 border-t pt-4 text-sm"
		>
			{prevUrl && (
				<a
					class="text-muted hover:text-global-text me-auto inline-flex min-h-11 items-center whitespace-nowrap"
					href={prevUrl.url}
				>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "← newer"}
				</a>
			)}
			{nextUrl && (
				<a
					class="text-muted hover:text-global-text ms-auto inline-flex min-h-11 items-center whitespace-nowrap"
					href={nextUrl.url}
				>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "older →"}
				</a>
			)}
		</nav>
	)
}
