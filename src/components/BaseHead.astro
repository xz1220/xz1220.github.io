---
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

type Props = SiteMeta;

const {
	articlePublishedDate,
	articleModifiedDate,
	articleSourceUrl,
	description,
	lang = siteConfig.lang,
	ogImage,
	ogImageHeight = 630,
	ogImageWidth = 1200,
	title,
} = Astro.props;

const titleSeparator = "·";
const siteTitle =
	title === siteConfig.title ? title : `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage ? ogImage : "/social-card.png", Astro.url).href;
const articleData = articlePublishedDate
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			mainEntityOfPage: canonicalURL.href,
			headline: title,
			description,
			inLanguage: lang,
			image: socialImageURL,
			datePublished: articlePublishedDate,
			...(articleModifiedDate ? { dateModified: articleModifiedDate } : {}),
			author: {
				"@type": "Person",
				name: siteConfig.author,
				url: new URL("/about/", Astro.site).href,
				sameAs: "https://www.zhihu.com/people/xz1220",
			},
			publisher: {
				"@type": "Person",
				name: siteConfig.author,
				url: new URL("/about/", Astro.site).href,
			},
			...(articleSourceUrl ? { isBasedOn: articleSourceUrl } : {}),
		}
	: undefined;
const articleJson = articleData ? JSON.stringify(articleData).replace(/</g, "\\u003c") : undefined;
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
<meta content="light dark" name="color-scheme" />
<title>{siteTitle}</title>

{/* Typography uses the native system stacks declared in the shared design tokens. */}

{/* Icons */}
<link href="/icon.svg?v=2" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon */}
			<link rel="icon" href="/favicon-32x32.png?v=2" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest?v=2" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Open Graph / Facebook */}
<meta content={articlePublishedDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={lang.startsWith("zh") ? "zh_CN" : siteConfig.ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content={title} property="og:image:alt" />
<meta content={String(ogImageWidth)} property="og:image:width" />
<meta content={String(ogImageHeight)} property="og:image:height" />
{
	articlePublishedDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articlePublishedDate} property="article:published_time" />
			{articleModifiedDate && <meta content={articleModifiedDate} property="article:modified_time" />}
		</>
	)
}
{articleJson && <script is:inline type="application/ld+json" set:html={articleJson} />}

{/* Twitter */}
<meta content="summary_large_image" property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link
	href="/rss.xml"
	title={`${siteConfig.title} posts`}
	rel="alternate"
	type="application/rss+xml"
/>

<meta content={Astro.generator} name="generator" />
