---
// Generic fallback plate for projects without a bespoke figure:
// a document routed to three output nodes — the shape of most of my tools.
---

<svg
	viewBox="0 0 720 300"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="Schematic figure: a document whose contents route out to three nodes"
	preserveAspectRatio="xMidYMid meet"
	class="plate h-auto w-full"
>
	<!-- source document -->
	<path class="plate-box" d="M240 90 h100 l24 24 v96 h-124 z"></path>
	<path class="plate-line" d="M340 90 v24 h24"></path>
	<path class="plate-line" d="M256 130 h60"></path>
	<path class="plate-line" d="M256 146 h60"></path>
	<path class="plate-line" d="M256 162 h40"></path>

	<!-- output nodes -->
	<circle class="plate-accent-stroke" cx="468" cy="86" r="14"></circle>
	<circle class="plate-box" cx="468" cy="150" r="14"></circle>
	<circle class="plate-box" cx="468" cy="214" r="14"></circle>

	<!-- connectors -->
	<path class="plate-line plate-flow" d="M364 150 C 416 150, 416 92, 452 88"></path>
	<path class="plate-line plate-flow" d="M364 150 H452"></path>
	<path class="plate-line plate-flow" d="M364 150 C 416 150, 416 208, 452 212"></path>
</svg>
