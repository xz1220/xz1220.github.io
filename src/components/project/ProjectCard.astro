---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Plate from "./Plate.astro";

interface Props {
	project: CollectionEntry<"project">;
	fig?: number;
}

const { project, fig } = Astro.props;
const { title, description, publishDate, repo, demo } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="group">
	<a
		class="border-line bg-global-bg hover:border-accent block overflow-hidden rounded-sm border transition-colors"
		href={href}
		aria-label={`${title} — project details`}
	>
		<div class="p-4 sm:p-6" aria-hidden="true">
			<Plate projectId={project.id} />
		</div>
	</a>
	<div class="mt-3 flex flex-wrap items-baseline gap-x-3">
		{
			fig !== undefined && (
				<span class="text-accent font-mono text-xs font-medium">
					FIG. {String(fig).padStart(2, "0")}
				</span>
			)
		}
		<h2 class="text-accent-2 font-display text-xl font-semibold tracking-tight">
			<a class="hover:decoration-accent no-underline underline-offset-4 hover:underline" href={href}
				>{title}</a
			>
		</h2>
		<p class="mono-label">
			<FormattedDate date={publishDate} />
		</p>
	</div>
	<p class="text-muted mt-1.5 max-w-prose text-[0.9375rem] leading-relaxed">{description}</p>
	<div class="mono-label mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
		{
			repo && (
				<a
					class="hover:text-accent no-underline underline-offset-4 hover:underline"
					href={repo}
					rel="noreferrer"
					target="_blank"
				>
					code
					<span aria-hidden="true" class="ml-0.5 text-xs">
						↗
					</span>
				</a>
			)
		}
		{
			demo && (
				<a
					class="hover:text-accent no-underline underline-offset-4 hover:underline"
					href={demo}
					rel="noreferrer"
					target="_blank"
				>
					demo
					<span aria-hidden="true" class="ml-0.5 text-xs">
						↗
					</span>
				</a>
			)
		}
		<a
			class="hover:text-accent no-underline underline-offset-4 hover:underline"
			href={href}
			aria-label={`read more about ${title}`}
		>
			read more →
		</a>
	</div>
</article>
