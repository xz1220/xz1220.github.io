---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	project: CollectionEntry<"project">;
	headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const { title, description, publishDate, repo, demo } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="project-card">
	<Heading class="entry-title">
		<a href={href}>{title}</a>
	</Heading>
	<p class="entry-summary">{description}</p>
	<footer class="entry-meta">
		<span><FormattedDate date={publishDate} /></span>
		{
			repo && (
				<>
					<span aria-hidden="true">·</span>
					<a href={repo} rel="noreferrer" target="_blank">
						Code ↗
					</a>
				</>
			)
		}
		{
			demo && (
				<>
					<span aria-hidden="true">·</span>
					<a href={demo} rel="noreferrer" target="_blank">
						Demo ↗
					</a>
				</>
			)
		}
		<span aria-hidden="true">·</span>
		<a href={href}>View project →</a>
	</footer>
</article>
