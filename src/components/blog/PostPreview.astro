---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
};

const { as: Tag = "div", post } = Astro.props;
const tag = post.data.tags[0];
---

<span class="mono-label shrink-0 pt-[0.1875rem] whitespace-nowrap">
	<FormattedDate date={post.data.publishDate} />
</span>
<Tag class="min-w-0 font-normal">
	{post.data.draft && <span class="text-accent font-mono text-sm">[draft] </span>}
	<a
		class="text-global-text hover:decoration-accent no-underline underline-offset-4 hover:underline"
		href={`/posts/${post.id}/`}
	>
		{post.data.title}
	</a>
</Tag>
{
	tag && (
		<>
			<span
				aria-hidden="true"
				class="border-line mx-1 hidden flex-1 border-b border-dotted sm:block"
			/>
			<span class="mono-label hidden shrink-0 pt-[0.1875rem] sm:block">#{tag}</span>
		</>
	)
}
