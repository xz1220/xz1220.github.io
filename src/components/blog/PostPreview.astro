---
import { type CollectionEntry, render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	post: CollectionEntry<"post">;
	headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const { remarkPluginFrontmatter } = await render(post);
const readingTime = String(remarkPluginFrontmatter.readingTime ?? "");
---

<article class="post-card">
	<Heading class="entry-title">
		{post.data.draft && <span class="text-accent text-sm">Draft · </span>}
		<a href={`/posts/${post.id}/`}>{post.data.title}</a>
	</Heading>
	<p class="entry-summary">{post.data.description}</p>
	<footer class="entry-meta">
		<span><FormattedDate date={post.data.publishDate} /></span>
		{
			readingTime && (
				<>
					<span aria-hidden="true">·</span>
					<span>{readingTime}</span>
				</>
			)
		}
		{
			post.data.tags[0] && (
				<>
					<span aria-hidden="true">·</span>
					<a href={`/tags/${post.data.tags[0]}/`}>#{post.data.tags[0]}</a>
				</>
			)
		}
	</footer>
</article>
