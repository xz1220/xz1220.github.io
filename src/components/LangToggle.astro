---
// Language toggle for bilingual posts.
// Sections marked with class="lang-section" and id="en" / "zh" are filtered client-side.
---

<nav class="lang-toggle" aria-label="Language">
	<button data-lang="en" class="active">EN</button>
	<button data-lang="zh">中文</button>
	<button data-lang="all">All</button>
</nav>

<style>
	.lang-toggle {
		display: flex;
		gap: 0.5rem;
		margin: 1rem 0 2rem;
	}
	.lang-toggle button {
		padding: 0.25rem 0.75rem;
		border: 1px solid rgb(var(--gray));
		background: transparent;
		border-radius: 0.25rem;
		cursor: pointer;
		font-size: 0.85rem;
		color: rgb(var(--gray-dark));
	}
	.lang-toggle button.active {
		background: var(--accent);
		color: white;
		border-color: var(--accent);
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.lang-toggle button');
	const sections = document.querySelectorAll<HTMLElement>('.lang-section');

	function apply(lang: string) {
		sections.forEach((s) => {
			s.style.display = lang === 'all' || s.id === lang ? '' : 'none';
		});
		buttons.forEach((b) => {
			b.classList.toggle('active', b.dataset.lang === lang);
		});
		try {
			localStorage.setItem('preferred-lang', lang);
		} catch {}
	}

	buttons.forEach((b) => {
		b.addEventListener('click', () => apply(b.dataset.lang || 'en'));
	});

	const hash = window.location.hash.replace('#', '');
	const stored = (() => {
		try {
			return localStorage.getItem('preferred-lang');
		} catch {
			return null;
		}
	})();
	const initial = ['en', 'zh', 'all'].includes(hash)
		? hash
		: stored && ['en', 'zh', 'all'].includes(stored)
			? stored
			: 'en';
	apply(initial);
</script>
