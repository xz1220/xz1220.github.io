---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	coverImage,
	description,
	lang = "en-GB",
	ogImage,
	publishDate,
	title,
	updatedDate,
} = post.data;
const socialImage = ogImage ?? coverImage?.src.src ?? `/og-image/${post.id}.png`;
const socialImageWidth = ogImage || !coverImage ? 1200 : coverImage.src.width;
const socialImageHeight = ogImage || !coverImage ? 630 : coverImage.src.height;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime = String(remarkPluginFrontmatter.readingTime ?? "");
const isChinese = lang.startsWith("zh");
---

<BaseLayout
	meta={{
		articleDate,
		description,
		lang,
		ogImage: socialImage,
		ogImageHeight: socialImageHeight,
		ogImageWidth: socialImageWidth,
		title,
	}}
>
	<article
		class:list={["article-page grow break-words", { "article-page--feature": coverImage }]}
		data-pagefind-body
		lang={lang}
	>
		<header class="article-header" id="blog-hero">
			<Masthead content={post} readingTime={readingTime} />
		</header>

		{!!headings.length && <TOC headings={headings} label={isChinese ? "目录" : "Contents"} />}

		<div class="prose">
			<slot />
		</div>

		{
			!!post.data.tags.length && (
				<nav aria-label={isChinese ? "文章标签" : "Article tags"} class="article-footer-tags">
					{post.data.tags.map((tag) => (
						<a data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}>
							#{tag}
						</a>
					))}
				</nav>
			)
		}
		<p class="article-footer-nav">
			<a class="back-link" href="/posts/">{isChinese ? "← 全部文章" : "← All posts"}</a>
		</p>
	</article>

	<button class="to-top-button" data-show="false" id="to-top-btn" tabindex="-1" type="button">
		<span class="sr-only">{isChinese ? "返回顶部" : "Back to top"}</span>
		<svg
			aria-hidden="true"
			class="h-5 w-5"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75 12 8.25l7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLElement;

	const observer = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const show = !entry.isIntersecting;
			scrollBtn.dataset.show = show.toString();
			scrollBtn.tabIndex = show ? 0 : -1;
		}
	});

	scrollBtn.addEventListener("click", () => {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		document.documentElement.scrollTo({ behavior: reduced ? "auto" : "smooth", top: 0 });
	});

	observer.observe(targetHeader);
</script>
