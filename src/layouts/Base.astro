---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: {
		articleDate,
		description = siteConfig.description,
		lang = siteConfig.lang,
		ogImage,
		ogImageHeight,
		ogImageWidth,
		title,
	},
} = Astro.props;
---

<html lang={lang}>
	<head>
		<ThemeProvider />
		<BaseHead
			articleDate={articleDate}
			description={description}
			lang={lang}
			ogImage={ogImage}
			ogImageHeight={ogImageHeight}
			ogImageWidth={ogImageWidth}
			title={title}
		/>
	</head>
	<body
		class="bg-global-bg text-global-text font-body mx-auto flex min-h-screen w-full max-w-3xl flex-col px-[14px] pt-6 text-base leading-[1.6] font-normal antialiased sm:px-6 sm:pt-8"
	>
		<SkipLink />
		<Header />
		<main id="main" class="grow" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "conservative"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
