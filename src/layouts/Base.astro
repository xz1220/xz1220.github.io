---
import BaseHead from "@/components/BaseHead.astro";
import Runhead from "@/components/book/Runhead.astro";
import SiteFoot from "@/components/book/SiteFoot.astro";
import CloudflareAnalytics from "@/components/CloudflareAnalytics.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/** "home", "article" … : the article pages narrow the running head to the text block. */
	bodyClass?: string;
}

const {
	bodyClass,
	meta: {
		articlePublishedDate,
		articleModifiedDate,
		articleSourceUrl,
		description = siteConfig.description,
		lang = siteConfig.lang,
		ogImage,
		ogImageHeight,
		ogImageWidth,
		title,
	},
} = Astro.props;

/*
	Webfonts. In production, scripts/localize-fonts.mjs replaces this link with a
	self-hosted /fonts/fonts.css holding only the slices the pages use, so readers
	never depend on Google (unreachable from mainland China).
*/
const WEBFONTS =
	"https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@400;600;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Zhi+Mang+Xing&display=swap";
---

<html lang={lang}>
	<head>
		{/* 日 / 夜: apply the saved choice, or the system's, before first paint. */}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var system = window.matchMedia("(prefers-color-scheme: dark)");
				function saved() {
					try {
						var t = localStorage.getItem("theme");
						return t === "light" || t === "dark" ? t : null;
					} catch (e) {
						return null;
					}
				}
				root.setAttribute("data-theme", saved() || (system.matches ? "dark" : "light"));
				system.addEventListener("change", function (e) {
					if (!saved()) root.setAttribute("data-theme", e.matches ? "dark" : "light");
				});
			})();
		</script>
		<BaseHead
			articlePublishedDate={articlePublishedDate}
			articleModifiedDate={articleModifiedDate}
			articleSourceUrl={articleSourceUrl}
			description={description}
			lang={lang}
			ogImage={ogImage}
			ogImageHeight={ogImageHeight}
			ogImageWidth={ogImageWidth}
			title={title}
		/>
		<link href="https://fonts.googleapis.com" rel="preconnect" />
		<link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
		<link data-webfonts href={WEBFONTS} rel="stylesheet" />
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main">跳到正文</a>
		<Runhead />
		<slot />
		<SiteFoot />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var button = document.querySelector(".theme");
				if (!button) return;
				function sync() {
					button.setAttribute("aria-pressed", String(root.getAttribute("data-theme") === "dark"));
				}
				button.addEventListener("click", function () {
					var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
					root.setAttribute("data-theme", next);
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
					sync();
				});
				new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
				sync();
			})();
		</script>
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "conservative"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
		<CloudflareAnalytics />
	</body>
</html>
